{
  "_comment": "Signals the car streams. A value is sent only when it changed AND interval_seconds elapsed, so a parked car sends almost nothing. Field names: https://github.com/teslamotors/fleet-telemetry/blob/main/protos/vehicle_data.proto",
  "Gear": { "interval_seconds": 1 },
  "VehicleSpeed": { "interval_seconds": 2 },
  "Location": { "interval_seconds": 2 },
  "GpsHeading": { "interval_seconds": 5 },
  "Odometer": { "interval_seconds": 10 },
  "PackVoltage": { "interval_seconds": 5 },
  "PackCurrent": { "interval_seconds": 5 },
  "EnergyRemaining": { "interval_seconds": 10 },
  "BatteryLevel": { "interval_seconds": 60 },
  "Soc": { "interval_seconds": 60 },
  "EstBatteryRange": { "interval_seconds": 60 },
  "OutsideTemp": { "interval_seconds": 60 },
  "InsideTemp": { "interval_seconds": 60 },
  "DetailedChargeState": { "interval_seconds": 1 },
  "ACChargingPower": { "interval_seconds": 30 },
  "DCChargingPower": { "interval_seconds": 10 },
  "ACChargingEnergyIn": { "interval_seconds": 60 },
  "DCChargingEnergyIn": { "interval_seconds": 60 },
  "FastChargerPresent": { "interval_seconds": 1 },
  "FastChargerType": { "interval_seconds": 60 },
  "ChargeLimitSoc": { "interval_seconds": 300 },
  "Version": { "interval_seconds": 3600 }
}
