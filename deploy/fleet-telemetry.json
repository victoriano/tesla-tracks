{
  "host": "0.0.0.0",
  "port": 4443,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "tesla",
  "reliable_ack": false,
  "transmit_decoded_records": true,
  "rate_limit": {
    "enabled": true,
    "message_interval_time": 30,
    "message_limit": 1000
  },
  "zmq": {
    "addr": "tcp://0.0.0.0:5284"
  },
  "records": {
    "V": ["zmq"],
    "connectivity": ["zmq"],
    "alerts": ["zmq"],
    "errors": ["zmq"]
  },
  "tls": {
    "server_cert": "/certs/fullchain.pem",
    "server_key": "/certs/privkey.pem"
  }
}
