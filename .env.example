# Copy to .env and fill in. Never commit .env.

# --- Tesla developer app (developer.tesla.com) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=eu                      # eu | na | cn
TESLA_APP_DOMAIN=tesla.example.com   # domain registered with Tesla; serves the public key
TESLA_REDIRECT_URI=https://tesla.example.com/auth/callback

# --- Where the car streams to (fleet-telemetry, mutual TLS, must NOT be behind a TLS-terminating proxy) ---
TELEMETRY_HOSTNAME=tesla.example.com
TELEMETRY_PORT=4443

# --- Dashboard ---
WEB_HOSTNAME=tracks.example.com
WEB_PORT=3000
TZ=UTC                               # e.g. Europe/Berlin, America/New_York
TT_LOCALE=en-US                      # date and number format, e.g. es-ES

# --- Local paths (when running the CLI outside Docker) ---
TT_DATA_DIR=./data
TT_SECRETS_DIR=./secrets
TT_UID=1000
TT_GID=1000

# --- Optional: mirror Parquet files to S3-compatible storage (Cloudflare R2 shown) ---
S3_BUCKET=
S3_PREFIX=tesla-tracks
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional: only for the bundled Caddy profile ---
ACME_EMAIL=
